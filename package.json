{
  "name": "law-managment-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Express TypeScript backend scaffold.",
  "license": "ISC",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "npm run lint && tsc",
    "lint": "eslint src",
    "start": "node dist/server.js",
    "generate": "drizzle-kit generate --config src/drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config src/drizzle.config.ts",
    "push": "drizzle-kit push --config src/drizzle.config.ts",
    "seed": "tsx src/db/seed/index.ts",
    "reset": "cross-env NODE_ENV=development tsx src/db/resetDb.ts",
    "reset:dev": "npm run reset"
  },
  "dependencies": {
    "@types/pdf-parse": "^1.1.5",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "openai": "^7.23.0",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.8",
    "razorpay": "^2.9.8",
    "slugify": "^1.6.9",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.0.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "nodemon": "^3.1.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
